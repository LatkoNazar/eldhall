{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	@backend path /api /api/* /health /health/*
	handle @backend {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:8080
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log
}
