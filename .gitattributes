* text=auto eol=lf
*.png binary
*.jpg binary

# Demo deliverables and source media stay shareable without bloating Git history.
demos/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
demos/**/*.webm filter=lfs diff=lfs merge=lfs -text
demos/**/*.mov filter=lfs diff=lfs merge=lfs -text
demos/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
demos/**/*.wav filter=lfs diff=lfs merge=lfs -text
demos/**/*.png filter=lfs diff=lfs merge=lfs -text
demos/**/*.jpg filter=lfs diff=lfs merge=lfs -text
demos/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
demos/**/*.woff2 filter=lfs diff=lfs merge=lfs -text

# Preserve generated subtitle formatting, the upstream license header and captured evidence.
demos/reference/youtube/assets/audio/*.srt -whitespace
demos/reference/youtube/assets/vendor/gsap.min.js -whitespace
demos/reference/youtube/qa/original-export/audio-loudness.txt -text -whitespace

# Reference-media rights are separate from the project's software licence.
# Keep local assets/history; omit them from future Git export archives.
docs/design-system/references/*.png export-ignore
demos/reference/youtube export-ignore
.agents/skills/eldhall-mvp-demo/assets/cursor export-ignore

# Preserve complete upstream notice formatting in the shipped browser artifacts.
apps/frontend/public/licenses/BROWSER_NOTICES.txt -whitespace
apps/landing/public/licenses/BROWSER_NOTICES.txt -whitespace

# Preserve the exact upstream font bytes and their licence integrity receipts.
apps/frontend/public/fonts/google-sans/*.ttf binary
apps/frontend/public/fonts/google-sans/OFL.txt -whitespace
