# Development and CI template. Copy to .env. Never commit the real .env or reuse these secrets on a server.
# Root stack: docker compose -f compose.yaml -f compose.prod.yaml up -d --build (docs/implementation.md).
# Support-only stack: deploy/support.compose.yaml with a private .env.support (docs/implementation.md#self-host-compose).
# PostgreSQL initial credentials apply when its data volume is FIRST initialized.
PROJECT_NAME=starter
# Optional per-checkout overrides (Compose also supports -p):
# COMPOSE_PROJECT_NAME=starter-worktree
# APP_IMAGE=starter:local
# FRONTEND_IMAGE=starter-frontend:local
# LANDING_IMAGE=starter-landing:local
# SUPPORT_SERVER_IMAGE=support-server:local
# SUPPORT_WEB_IMAGE=support-web:local
ENVIRONMENT=development
# Optional existing PostgreSQL database; takes precedence over POSTGRES_* in API/worker/migrations.
# Quote the URL and percent-encode reserved characters in username/password.
# DATABASE_URL='postgresql://support_user:encoded_password@db.example.com:5432/existing_app?sslmode=verify-full'
# Docker without a local PostgreSQL: deploy/support.external-db.compose.yaml.
DATABASE_URL=
# Compose sets the service hostnames internally. Native API/worker runs
# (docs/implementation.md#native-start) use host-side values instead:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=development-postgres-only
REDIS_PASSWORD=development-redis-only
API_TOKEN=development-token-not-for-production
# Support copilot. Operator console bearer token (typed on the /operator login screen).
OPERATOR_TOKEN=development-operator-token
# memory (explicit demo, resets on restart) | postgres (persistent support storage)
SUPPORT_STORE=memory
# Optional: bind this deployment to one server-selected business (UUID).
# Leave blank for the multi-business operator console.
# SUPPORT_WORKSPACE_BUSINESS_ID=
# Empty = enabled in development, disabled in production. Set false for clean bootstrap.
DEMO_RESET_ENABLED=
# rules (explicit offline demo) | google | openai | anthropic | local.
# Configured model providers use DeepSeek Harness. No browser receives model keys.
LLM_PROVIDER=rules
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# For the project model use LLM_PROVIDER=google, AGENT_RUNTIME=dsh,
# LLM_MODEL=gemini-3.5-flash-lite, LLM_TIMEOUT_MS=60000 and GEMINI_API_KEY.
# AGENT_RUNTIME=dsh
RUNTIME_HOME=.runtime/dsh
MAX_RUNTIME_TOOL_CALLS=8
LLM_BASE_URL=
LOCAL_MODEL_API_KEY=
# Optional reviewed JSON config: see examples/support.config.json.
# Relative native paths resolve from apps/api; for example ../../examples/support.config.json.
SUPPORT_CONFIG_FILE=
# Optional Compose config overlay (paths resolve from deploy/):
# SUPPORT_CONFIG_PATH=../examples/support.config.json
# SUPPORT_CONNECTOR_ENV_FILE=../.env.connectors
# For persistent queued execution use postgres + worker. Memory demo derives inline.
# SUPPORT_EXECUTION=worker
# Gemini default for this project: gemini-3.5-flash-lite.
GEMINI_API_KEY=
# Server-side secrets only. Never commit real keys; never prefix with PUBLIC_/VITE_.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional dedicated ticket classifier. The conversational DSH model above stays independent.
# agent = classification in the normal conversational decision; openrouter = Decisions API.
CLASSIFICATION_PROVIDER=agent
# For OpenRouter use the exact supported Decisions model, for example:
# CLASSIFICATION_MODEL=openai/gpt-6-luna-decisions
CLASSIFICATION_MODEL=
CLASSIFICATION_TIMEOUT_MS=10000

# Knowledge base retrieval (docs/KNOWLEDGE_BASE.md).
# local = deterministic hashing embedder, no key. openai uses OPENAI_API_KEY, google uses GEMINI_API_KEY.
# Changing the provider/model is a new index version: run POST /api/v1/knowledge/reindex.
KB_EMBEDDINGS_PROVIDER=local
KB_EMBEDDINGS_MODEL=
# Hosts the operator may import help pages from (https only; private addresses are always refused).
KB_URL_ALLOWLIST=[]
# Server-only credentials for configured external KB connections; never expose as VITE_/PUBLIC_ variables.
QDRANT_API_KEY=
KB_EXTERNAL_EMBEDDING_API_KEY=
OPENROUTER_API_KEY=
# Independent analytics storage and signing secret. Use URL-safe database credentials.
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=development-umami-postgres-only
UMAMI_APP_SECRET=development-umami-secret-not-for-production
# Public browser build-time configuration; never put credentials here.
# Create a website in the local Umami dashboard, then set its real UUID and script URL.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_DOMAINS=
# JSON arrays. Production must include the domain AND 127.0.0.1 for container healthchecks.
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
# Frontend uses a same-origin proxy in development and production.
# Independent widgets may use an explicit origin list; GET/POST/PATCH and
# Authorization/Content-Type/X-Customer-Session are allowed, without credential cookies.
CORS_ORIGINS='[]'
WORKER_CONCURRENCY=2
# BullMQ uses the existing Redis service, isolated from cache DB0 and historical result DB1.
BULLMQ_DB=2
BULLMQ_PREFIX=node-bullmq
BULLMQ_QUEUE=jobs-transform-v1
BULLMQ_ATTEMPTS=4
BULLMQ_BACKOFF_MS=1000
BULLMQ_RETENTION_COUNT=1000
BULLMQ_COMPLETED_RETENTION_SECONDS=3600
BULLMQ_FAILED_RETENTION_SECONDS=86400
# Docker bind mounts use polling for reliable TypeScript watch on Windows/macOS.
# Set false on a Linux host with native filesystem events if desired.
API_WATCH_USE_POLLING=true
API_WATCH_INTERVAL=500
API_LOCAL_PORT=8000
# Vite dev proxy target; Compose sets http://api:8000 for the container build.
# API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_LOCAL_PORT=5173
LANDING_LOCAL_PORT=5174
UMAMI_LOCAL_PORT=3001
POSTGRES_LOCAL_PORT=5432
REDIS_LOCAL_PORT=6379
# Production loopback ports: API only and frontend with same-origin API proxy.
APP_PORT=18000
FRONTEND_PORT=18001
LANDING_PORT=18002
UMAMI_PORT=18003
# Support-only stack loopback ports (deploy/support.compose.yaml):
# SUPPORT_API_PORT=18000
# SUPPORT_WEB_PORT=18001
# Optional Caddy overlay only: DNS must point here; ports 80/443 must be available.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com
# Optional three-host Caddy overlay; DOMAIN remains the existing application host.
# LANDING_DOMAIN=example.com
# Public HTTPS origin of the marketing site. Enables canonical URLs and JSON-LD in the landing build.
# PUBLIC_LANDING_URL=https://example.com
# UMAMI_DOMAIN=analytics.example.com

# Optional OpenAPI URL onboarding (deploy/compose.managed-mcp.yaml); see docs/OPENAPI_QUICKSTART.md.
# Use the same private service credential in API, worker and managed adapter.
# MANAGED_MCP_IMAGE=eldhall-mcp-managed:local
# MANAGED_MCP_URL=http://mcp-managed:8000
# MANAGED_MCP_TOKEN=replace-with-at-least-24-random-characters
# MANAGED_MCP_ALLOW_INSECURE_HTTP=true
# MANAGED_UPSTREAM_PROFILES={}
# Optional OpenAPI -> MCP sidecar (deploy/support.mcp.compose.yaml); see docs/OPENAPI_QUICKSTART.md.
# SUPPORT_MCP_IMAGE=support-mcp-openapi:local
# MCP_MANIFEST_PATH=../examples/orders/manifest.json
# MCP_UPSTREAM_BASE_URL=https://your-business-api.example
# MCP_UPSTREAM_TOKEN=
# MCP_UPSTREAM_PRINCIPAL_ID=orders-service
# MCP_UPSTREAM_TIMEOUT_SECONDS=4
# MCP_UPSTREAM_ALLOW_INSECURE_HTTP=false
# MCP_CONNECTION_REVISION=1
# MCP_MEMORY_LIMIT=256m
# MCP_INTERNAL_HTTP_ORIGINS='["http://mcp-openapi:8000"]'
# Shared by API, worker and the sidecar. Use a new private value, not the operator key.
# MCP_SERVICE_TOKEN=replace-with-at-least-16-random-characters
