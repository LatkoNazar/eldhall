{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "smoke": "node scripts/smoke.mjs",
    "test:postgres": "node --import tsx --test tests/postgres-store.integration.ts tests/insights.integration.ts tests/integration-state.integration.ts",
    "test:mcp-openapi": "node --import tsx --test tests/mcp-openapi.integration.ts",
    "test:runtime": "node --import tsx --test tests/runtime.test.ts tests/insights-runtime.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@modelcontextprotocol/client": "2.3.0",
    "bullmq": "6.5.2",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "zod@>=4 <5": "4.6.7",
    "undici@>=8 <9": "8.12.2",
    "@modelcontextprotocol/client": "2.3.0"
  }
}
