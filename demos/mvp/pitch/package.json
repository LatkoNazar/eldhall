{
  "name": "eldhall-pitch-video",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build": "npm run verify && node scripts/build.mjs --final",
    "dev": "hyperframes preview",
    "check": "hyperframes check",
    "snapshot": "hyperframes snapshot --at 2.45,9.109,34.55,43.5 --no-end --output .hyperframes/portable-preview",
    "render": "hyperframes render --fps 30 --quality delivery --workers 2 --video-frame-format png --frames-cache-dir .cache/frames --output exports/eldhall-pitch-uk.mp4",
    "verify:source": "node scripts/verify.mjs --source-only",
    "test": "node --test scripts/verify.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "gsap": "3.14.2",
    "hyperframes": "0.8.221"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
